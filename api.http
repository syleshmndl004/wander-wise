}

### GET ALL TRIPS
GET {{baseUrl}}/trips
Authorization: Bearer {{token}}

### GET TRIP BY ID
GET {{baseUrl}}/trips/{{tripId}}
Authorization: Bearer {{token}}

### UPDATE TRIP BY ID
PATCH {{baseUrl}}/trips/{{tripId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Updated Trip to Nepal",
  "budget": {
    "total": 2500
  }
}

### DELETE TRIP BY ID
DELETE {{baseUrl}}/trips/{{tripId}}
Authorization: Bearer {{token}}


#### CREATE BAGGAGE
POST {{baseUrl}}/trips/{{tripId}}/baggages
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Backpack"
}

#### CREATE ITINERARY
POST {{baseUrl}}/trips/{{tripId}}/itineraries
Content-Type: application/json
Authorization: ******

{
  "title": "Day 1 in Paris",
  "description": "Arrival and sightseeing",
  "date": "2024-07-01",
  "activities": [
    {
      "name": "Visit the Eiffel Tower",
      "time": "2024-07-01T14:00:00.000Z",
      "notes": ["Book tickets in advance"]
    }
  ]
}

### GET ALL ITINERARIES
GET {{baseUrl}}/trips/{{tripId}}/itineraries
Authorization: ******

### GET ITINERARY BY ID
GET {{baseUrl}}/trips/{{tripId}}/itineraries/{{itineraryId}}
Authorization: ******

### UPDATE ITINERARY BY ID
PATCH {{baseUrl}}/trips/{{tripId}}/itineraries/{{itineraryId}}
Content-Type: application/json
Authorization: ******

{
  "title": "Updated Day 1 in Paris"
}

### DELETE ITINERARY BY ID
DELETE {{baseUrl}}/trips/{{tripId}}/itineraries/{{itineraryId}}
Authorization: ******

